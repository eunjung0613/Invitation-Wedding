# ============================================================
# Firebase Web App 설정 (무료 Spark 요금제 — Firestore 전용)
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹(</>)
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Firebase Admin SDK 서비스 계정 키 (관리자 /admin 서버 API 전용)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성(JSON)
# 다운로드한 JSON 파일 전체 내용을 그대로(또는 Base64로) 넣어주세요.
# ============================================================
FIREBASE_SERVICE_ACCOUNT_KEY=

# ============================================================
# Vercel Blob 토큰 (카드 등록 없는 무료 플랜 — 하객 스냅 사진 저장용)
# Vercel 대시보드 > 프로젝트 > Storage > Blob 생성 시 자동 주입됩니다.
# ============================================================
BLOB_READ_WRITE_TOKEN=

# ============================================================
# 신랑·신부 전용 관리자 페이지 (/admin) 비밀번호
# ============================================================
NEXT_PUBLIC_ADMIN_PASSWORD=0328

# ============================================================
# (선택) 배포 도메인 (카카오톡/SNS 링크 미리보기 OG 이미지용)
# 예: https://wedding.minnote.net
# ============================================================
NEXT_PUBLIC_SITE_URL=
